# --- secrets & local config -------------------------------------------------
.env
.env.*
!.env.example
# Setup notes that carry a real OAuth client secret. Not the whole of doc/: the Preventia API
# guides in there are tracked on purpose, and ignoring the folder would only hide new files
# while leaving those committed.
doc/SOCIAL_LOGIN_SETUP.md

# --- local runtime state (never deployable) ---------------------------------
instance/
dev.db
*.db
*.db-journal
*.bak*
logs/
*.log
sessions/

# --- user uploads (keep the empty folder) -----------------------------------
app/static/uploads/*
!app/static/uploads/.gitkeep

# --- python -----------------------------------------------------------------
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# --- scraper output ---------------------------------------------------------
*.xlsx

# --- editors & OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
