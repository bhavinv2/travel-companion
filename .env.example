FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
# Leave unset for local SQLite (sqlite:///dev.db); Railway/Cloud SQL inject a postgres URL in production.
DATABASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=noreply@connectingdesis.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@connectingdesis.com
UPLOAD_FOLDER=app/static/uploads
# Ticket attachments and other sensitive files - never under /static
PRIVATE_UPLOAD_FOLDER=instance/private_uploads
MAX_CONTENT_LENGTH=16777216
# Phase 2
SITE_URL=https://connectingdesis.com
SUPPORT_EMAIL=support@connectingdesis.com
CLAIM_TOKEN_DAYS=14
# Show the route/dates of a CS-created post on its claim page (True/False)
CLAIM_SHOW_ROUTE=True
# Shared secret for the scheduler endpoint POST /internal/jobs/run (header X-Jobs-Secret). Leave empty to disable.
JOBS_SECRET=
RETENTION_DAYS=30
RATELIMIT_ENABLED=True
# Optional matching weight overrides (JSON), e.g. {"route": 40, "flight": 10}
MATCH_WEIGHTS=
# Storage: local | s3   (s3 needs `pip install boto3`)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Mail provider: smtp | sendgrid
MAIL_PROVIDER=smtp
SENDGRID_API_KEY=
# Admin web scraper (/cs/scraper). Needs `playwright install chromium` in the app environment.
SCRAPER_ENABLED=True
# Only when the app runs on your own PC: adds "Teach in a browser window" (opens a real Chromium window)
SCRAPER_HEADED_TEACH=False
SCRAPER_MAX_WORKERS=1
SCRAPER_STALE_MINUTES=10
SCRAPER_ROWS_RETENTION_DAYS=30
SCRAPER_EXPORT_DIR=instance/scraper_exports
SCRAPER_SESSION_DIR=instance/scraper_sessions
# Extra Chromium flags, e.g. --no-sandbox when the container runs as root
FETCHALL_CHROMIUM_ARGS=
